# ─────────────────────────────────────────────────────────────────
#  .env.example — Bu dosyayı .env olarak kopyalayın ve doldurun
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# Genel
NODE_ENV=production
PORT=5000

# ─── Veritabanı ───────────────────────────────────────────────────
POSTGRES_USER=ecom
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ecommerce
# Docker Compose'da container adı 'postgres'
DATABASE_URL=postgresql://ecom:CHANGE_ME_strong_db_password@postgres:5432/ecommerce

# ─── Redis ────────────────────────────────────────────────────────
# Docker Compose'da container adı 'redis'
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────
# En az 32 karakter, rastgele üretin: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_random_hex
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────
# Admin de aynı domain'de olduğu için her ikisi de aynı değer
FRONTEND_URL=https://example.com
ADMIN_URL=https://example.com

# ─── Email ────────────────────────────────────────────────────────
# Öncelik sırası: SMTP > Brevo API > sadece log
#
# Seçenek 1 — SMTP (Gmail, Yandex, özel sunucu...)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@example.com
#
# Seçenek 2 — Brevo Transactional Email API (SMTP_HOST boşsa devreye girer)
# API anahtarı: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
# Boş bırakılırsa mağaza adı (kurulumda girilen) kullanılır
BREVO_SENDER_NAME=

# ─── Cloudinary (opsiyonel, yerel depolama yerine) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google Sign-In (opsiyonel) ───────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Yetkili JS kaynağı olarak alan adınızı ekleyin (örn. https://example.com)
# Backend token doğrulaması ve frontend butonu AYNI değeri kullanır.
GOOGLE_CLIENT_ID=
# Frontend build sırasında kullanılır (Vite). Genelde GOOGLE_CLIENT_ID ile aynı değer.
VITE_GOOGLE_CLIENT_ID=

# ─── İyzico (ödeme) ───────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─── Admin varsayılan kullanıcı (ilk seed için) ───────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ─── Sysmond E-Dönüşüm (REST/JSON) ───────────────────────────────
# Test: https://integration-test.sysmond.com.tr/api  kullanıcı: SysmondWS / SysmondWS
# Canlı: https://integration.sysmond.com.tr/api      aktivasyon sonrası bildirilir
SYSMOND_API_URL=https://integration-test.sysmond.com.tr/api
SYSMOND_USERNAME=
SYSMOND_PASSWORD=CHANGE_ME
# Sysmond portal → Ayarlar → Tanımlar → Sayaç Bilgileri'nde tanımlı seri öneki
SYSMOND_INVOICE_PREFIX=MAB
